# App
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/american_board
ALEMBIC_DATABASE_URL=${DATABASE_URL}

# App metadata and base URL
APP_NAME=American Board of AI Exam System
BASE_URL=http://localhost:8000

# Mail settings (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=${APP_NAME}
MAIL_USE_TLS=true
MAIL_ENCRYPTION=tls

PHASE2_ENABLED=true
PHASE2_PHASE_ID=2
PHASE2_MAX_QUESTIONS=20
PHASE2_PASSING_SCORE=75
PHASE2_INITIAL_THETA=0.0

# RAG review: when true, generated questions start as "draft" (requires admin review)
RAG_REVIEW_REQUIRED=false

# Provider selection ("openai", "gemini", or "groq")
RAG_EMBEDDING_PROVIDER=openai
RAG_GENERATION_PROVIDER=openai

# OpenAI (current provider)
OPENAI_API_KEY=your_openai_api_key

# Gemini (alternative provider)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_EMBEDDING_MODEL=text-embedding-002
# GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Groq (OpenAI-compatible provider for RAG)
GROQ_API_KEY=your_groq_api_key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_EMBEDDING_MODEL=mxbai-embed-large
# GROQ_GENERATION_MODEL=llama-3.3-70b-versatile

# Weaviate vector store
WEAVIATE_URL=http://localhost:8080

# When true, falls back to random PG chunks if Weaviate search fails (dev only)
RAG_ALLOW_VECTOR_FALLBACK=false

# Enable OCR fallback for scanned PDFs (requires pytesseract + tesseract-ocr)
RAG_OCR_ENABLED=false