# App
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/american_board
ALEMBIC_DATABASE_URL=${DATABASE_URL}

# App metadata and base URL
APP_NAME=American Board of AI Exam System
BASE_URL=http://localhost:8000

# Mail settings (Gmail SMTP example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=${APP_NAME}
MAIL_USE_TLS=true
MAIL_ENCRYPTION=tls